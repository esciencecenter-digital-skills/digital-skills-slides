mple-of-citationcff-file",[321],{"type":23,"value":322},"Minimal example of CITATION.cff file",{"type":17,"tag":324,"props":325,"children":330},"pre",{"className":326,"code":328,"language":329,"meta":7},[327],"language-yaml","authors:\n  - family-names: Doe\n    given-names: Jane\ncff-version: 1.2.0\nmessage: \"If you use this software, please cite it using the metadata from this file.\"\ntitle: \"My research software\"\n","yaml",[331],{"type":17,"tag":332,"props":333,"children":334},"code",{"__ignoreMap":7},[335],{"type":23,"value":328},{"type":17,"tag":25,"props":337,"children":338},{},[339],{"type":23,"value":29},{"type":17,"tag":41,"props":341,"children":343},{"id":342},"why-write-in-code-documentation",[344],{"type":23,"value":345},"Why write in-code documentation?",{"type":17,"tag":25,"props":347,"children":348},{},[349],{"type":23,"value":350},"In-code documentation:",{"type":17,"tag":48,"props":352,"children":353},{},[354,359],{"type":17,"tag":52,"props":355,"children":356},{},[357],{"type":23,"value":358},"Makes code more understandable",{"type":17,"tag":52,"props":360,"children":361},{},[362],{"type":23,"value":363},"Explains decisions we made",{"type":17,"tag":25,"props":365,"children":366},{},[367],{"type":23,"value":29},{"type":17,"tag":41,"props":369,"children":371},{"id":370},"when-not-to-use-in-code-documentation",[372,374,380],{"type":23,"value":373},"When ",{"type":17,"tag":375,"props":376,"children":377},"strong",{},[378],{"type":23,"value":379},"not",{"type":23,"value":381}," to use in-code documentation?",{"type":17,"tag":48,"props":383,"children":384},{},[385,390,395,400],{"type":17,"tag":52,"props":386,"children":387},{},[388],{"type":23,"value":389},"When the code is self-explanatory",{"type":17,"tag":52,"props":391,"children":392},{},[393],{"type":23,"value":394},"To replace good variable/function names",{"type":17,"tag":52,"props":396,"children":397},{},[398],{"type":23,"value":399},"To replace version control",{"type":17,"tag":52,"props":401,"children":402},{},[403],{"type":23,"value":404},"To keep old (zombie) code around",{"type":17,"tag":25,"props":406,"children":407},{},[408],{"type":23,"value":29},{"type":17,"tag":41,"props":410,"children":412},{"id":411},"readable-code-vs-commented-code",[413],{"type":23,"value":414},"Readable code vs commented code",{"type":17,"tag":324,"props":416,"children":421},{"className":417,"code":419,"language":420,"meta":7},[418],"language-python=","# convert from degrees celsius to fahrenheit\ndef convert(d):\n    return d * 5 / 9 + 32\n","python=",[422],{"type":17,"tag":332,"props":423,"children":424},{"__ignoreMap":7},[425],{"type":23,"value":419},{"type":17,"tag":25,"props":427,"children":428},{},[429],{"type":23,"value":430},"vs",{"type":17,"tag":324,"props":432,"children":435},{"className":433,"code":434,"language":420,"meta":7},[418],"def celsius_to_fahrenheit(degrees):\n    return degrees * 5 / 9 + 32\n",[436],{"type":17,"tag":332,"props":437,"children":438},{"__ignoreMap":7},[439],{"type":23,"value":434},{"type":17,"tag":25,"props":441,"children":442},{},[443],{"type":23,"value":29},{"type":17,"tag":41,"props":445,"children":447},{"id":446},"what-makes-a-good-comment",[448],{"type":23,"value":449},"What makes a good comment?",{"type":17,"tag":25,"props":451,"children":452},{},[453],{"type":17,"tag":375,"props":454,"children":455},{},[456],{"type":23,"value":457},"Comment A",{"type":17,"tag":324,"props":459,"children":461},{"dataId":460},"code-animation",[462],{"type":17,"tag":332,"props":463,"children":467},{"style":464,"dataTrim":7,"className":465},"overflow: hidden;",[466],"python",[468],{"type":23,"value":469},"\n# Now we check if temperature is larger than -50:\nif temperature > -50:\n    print('do something')\n",{"type":17,"tag":25,"props":471,"children":472},{},[473],{"type":17,"tag":375,"props":474,"children":475},{},[476],{"type":23,"value":477},"Comment B",{"type":17,"tag":324,"props":479,"children":480},{"dataId":460},[481],{"type":17,"tag":332,"props":482,"children":484},{"style":464,"dataTrim":7,"className":483},[466],[485],{"type":23,"value":486},"\n# We regard temperatures below -50 degrees as measurement errors\nif temperature > -50:\n    print('do something')\n",{"type":17,"tag":25,"props":488,"children":489},{},[490],{"type":23,"value":491},"How are these different? Which one do you prefer?",{"type":17,"tag":25,"props":493,"children":494},{},[495],{"type":23,"value":29},{"type":17,"tag":41,"props":497,"children":499},{"id":498},"docstrings-a-special-kind-of-comment",[500],{"type":23,"value":501},"Docstrings: a special kind of comment",{"type":17,"tag":324,"props":503,"children":506},{"className":504,"code":505,"language":420,"meta":7},[418],"def celsius_to_fahrenheit(degrees):\n  \"\"\"Convert degrees Celsius to degrees Fahrenheit.\"\"\"\n  return degrees * 5 / 9 + 32\n",[507],{"type":17,"tag":332,"props":508,"children":509},{"__ignoreMap":7},[510],{"type":23,"value":505},{"type":17,"tag":25,"props":512,"children":513},{},[514],{"type":23,"value":515},"Why is this OK?",{"type":17,"tag":25,"props":517,"children":518},{},[519],{"type":23,"value":520},"Note:\nDocstrings can be used to generate user documentation.\nThey are accessible outside the code.\nThey follow a standardized syntax.",{"type":17,"tag":25,"props":522,"children":523},{},[524],{"type":23,"value":29},{"type":17,"tag":41,"props":526,"children":528},{"id":527},"in-code-commenting-key-points",[529],{"type":23,"value":530},"In-code commenting: key points",{"type":17,"tag":48,"props":532,"children":533},{},[534,539,544],{"type":17,"tag":52,"props":535,"children":536},{},[537],{"type":23,"value":538},"Explicit, descriptive naming already provides important documentation.",{"type":17,"tag":52,"props":540,"children":541},{},[542],{"type":23,"value":543},"Comments should describe the why for your code, not the what.",{"type":17,"tag":52,"props":545,"children":546},{},[547],{"type":23,"value":548},"Writing docstrings is an easy way to write documentation while you code, as they are accessible outside the code itself.",{"type":17,"tag":25,"props":550,"children":551},{},[552],{"type":23,"value":29},{"type":17,"tag":41,"props":554,"children":556},{"id":555},"userapi-documentation",[557],{"type":23,"value":558},"User/API documentation",{"type":17,"tag":48,"props":560,"children":561},{},[562,567],{"type":17,"tag":52,"props":563,"children":564},{},[565],{"type":23,"value":566},"What if a README file is not enough?",{"type":17,"tag":52,"props":568,"children":569},{},[570],{"type":23,"value":571},"How do I easily create user documentation?",{"type":17,"tag":25,"props":573,"children":574},{},[575],{"type":23,"value":29},{"type":17,"tag":41,"props":577,"children":579},{"id":578},"tools",[580],{"type":23,"value":581},"Tools",{"type":17,"tag":48,"props":583,"children":584},{},[585,642],{"type":17,"tag":52,"props":586,"children":587},{},[588,590,595,597,602,604],{"type":23,"value":589},"Documentation generators (e.g. ",{"type":17,"tag":375,"props":591,"children":592},{},[593],{"type":23,"value":594},"mkdocs",{"type":23,"value":596},", ",{"type":17,"tag":375,"props":598,"children":599},{},[600],{"type":23,"value":601},"Sphinx",{"type":23,"value":603},")\n",{"type":17,"tag":48,"props":605,"children":606},{},[607,612,617,622,627],{"type":17,"tag":52,"props":608,"children":609},{},[610],{"type":23,"value":611},"creates nicely-formatted HTML pages out of .md or .rst files",{"type":17,"tag":52,"props":613,"children":614},{},[615],{"type":23,"value":616},"numerous plugins available to extend functionality (API, spellcheck, etc.)",{"type":17,"tag":52,"props":618,"children":619},{},[620],{"type":23,"value":621},"programming language independent",{"type":17,"tag":52,"props":623,"children":624},{},[625],{"type":23,"value":626},"easy to use and deploy (e.g. GitHub pages)",{"type":17,"tag":52,"props":628,"children":629},{},[630,634,636,640],{"type":17,"tag":375,"props":631,"children":632},{},[633],{"type":23,"value":594},{"type":23,"value":635}," easier to start with, but ",{"type":17,"tag":375,"props":637,"children":638},{},[639],{"type":23,"value":601},{"type":23,"value":641}," is more complete and robust",{"type":17,"tag":52,"props":643,"children":644},{},[645,650,652],{"type":17,"tag":375,"props":646,"children":647},{},[648],{"type":23,"value":649},"Github pages",{"type":23,"value":651}," (deploy your documentation)\n",{"type":17,"tag":48,"props":653,"children":654},{},[655,660],{"type":17,"tag":52,"props":656,"children":657},{},[658],{"type":23,"value":659},"set up inside your GitHub repository",{"type":17,"tag":52,"props":661,"children":662},{},[663],{"type":23,"value":664},"automatically deploys your Sphinx-generated documentation",{"type":17,"tag":25,"props":666,"children":667},{},[668],{"type":23,"value":29},{"type":17,"tag":41,"props":670,"children":672},{"id":671},"using-mkdocs",[673,675],{"type":23,"value":674},"Using ",{"type":17,"tag":375,"props":676,"children":677},{},[678],{"type":23,"value":594},{"type":17,"tag":48,"props":680,"children":681},{},[682,693,706,719,731,744],{"type":17,"tag":52,"props":683,"children":684},{},[685,687],{"type":23,"value":686},"In a new code directory, run ",{"type":17,"tag":332,"props":688,"children":690},{"className":689},[],[691],{"type":23,"value":692},"mkdocs new .",{"type":17,"tag":52,"props":694,"children":695},{},[696,698,704],{"type":23,"value":697},"Edit the ",{"type":17,"tag":332,"props":699,"children":701},{"className":700},[],[702],{"type":23,"value":703},"mkdocs.yml",{"type":23,"value":705}," file to configure your documentation",{"type":17,"tag":52,"props":707,"children":708},{},[709,711,717],{"type":23,"value":710},"Run ",{"type":17,"tag":332,"props":712,"children":714},{"className":713},[],[715],{"type":23,"value":716},"mkdocs build",{"type":23,"value":718}," to generate the documentation site",{"type":17,"tag":52,"props":720,"children":721},{},[722,723,729],{"type":23,"value":710},{"type":17,"tag":332,"props":724,"children":726},{"clas