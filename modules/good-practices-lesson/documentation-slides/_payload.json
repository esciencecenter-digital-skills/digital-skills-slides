ps":75,"children":76},"quotation",{},[77],{"type":23,"value":78},"\nNB: You can choose a mature library with lots of users, but try to also think of less mature projects you had to collaborate on, or papers you had to reproduce.\n",{"type":17,"tag":25,"props":80,"children":81},{},[82],{"type":23,"value":29},{"type":17,"tag":41,"props":84,"children":86},{"id":85},"types-of-documentation",[87],{"type":23,"value":88},"Types of documentation",{"type":17,"tag":90,"props":91,"children":94},"div",{"className":92},[93],"fragment",[95],{"type":17,"tag":48,"props":96,"children":97},{},[98,103,108,113,118],{"type":17,"tag":52,"props":99,"children":100},{},[101],{"type":23,"value":102},"README files and CITATION files",{"type":17,"tag":52,"props":104,"children":105},{},[106],{"type":23,"value":107},"In-code documentation (Docstrings)",{"type":17,"tag":52,"props":109,"children":110},{},[111],{"type":23,"value":112},"API documentation",{"type":17,"tag":52,"props":114,"children":115},{},[116],{"type":23,"value":117},"Tutorials",{"type":17,"tag":52,"props":119,"children":120},{},[121],{"type":23,"value":122},"...",{"type":17,"tag":25,"props":124,"children":125},{},[126],{"type":23,"value":29},{"type":17,"tag":41,"props":128,"children":130},{"id":129},"a-good-readme-file",[131],{"type":23,"value":132},"A good README file",{"type":17,"tag":48,"props":134,"children":135},{},[136,141],{"type":17,"tag":52,"props":137,"children":138},{},[139],{"type":23,"value":140},"README file is first thing a user/collaborator sees",{"type":17,"tag":52,"props":142,"children":143},{},[144],{"type":23,"value":145},"What should be included in README files?",{"type":17,"tag":48,"props":147,"children":148},{},[149,151,156,157,161,162,166,167,171,172,176,177,181,182],{"type":23,"value":150},"\n  ",{"type":17,"tag":52,"props":152,"children":154},{"contentEditable":153},"true",[155],{"type":23,"value":122},{"type":23,"value":150},{"type":17,"tag":52,"props":158,"children":159},{"contentEditable":153},[160],{"type":23,"value":122},{"type":23,"value":150},{"type":17,"tag":52,"props":163,"children":164},{"contentEditable":153},[165],{"type":23,"value":122},{"type":23,"value":150},{"type":17,"tag":52,"props":168,"children":169},{"contentEditable":153},[170],{"type":23,"value":122},{"type":23,"value":150},{"type":17,"tag":52,"props":173,"children":174},{"contentEditable":153},[175],{"type":23,"value":122},{"type":23,"value":150},{"type":17,"tag":52,"props":178,"children":179},{"contentEditable":153},[180],{"type":23,"value":122},{"type":23,"value":150},{"type":17,"tag":52,"props":183,"children":184},{"contentEditable":153},[185],{"type":23,"value":122},{"type":17,"tag":25,"props":187,"children":188},{},[189],{"type":23,"value":190},"Note:",{"type":17,"tag":48,"props":192,"children":193},{},[194,199,204,209,214,219,224,229,234,239,244],{"type":17,"tag":52,"props":195,"children":196},{},[197],{"type":23,"value":198},"A descriptive project title",{"type":17,"tag":52,"props":200,"children":201},{},[202],{"type":23,"value":203},"Motivation (why the project exists) and basics",{"type":17,"tag":52,"props":205,"children":206},{},[207],{"type":23,"value":208},"Installation / How to setup",{"type":17,"tag":52,"props":210,"children":211},{},[212],{"type":23,"value":213},"Copy-pasteable quick start code example",{"type":17,"tag":52,"props":215,"children":216},{},[217],{"type":23,"value":218},"Usage reference (if not elsewhere)",{"type":17,"tag":52,"props":220,"children":221},{},[222],{"type":23,"value":223},"Citation if someone uses it",{"type":17,"tag":52,"props":225,"children":226},{},[227],{"type":23,"value":228},"Other related tools (\"see also\")",{"type":17,"tag":52,"props":230,"children":231},{},[232],{"type":23,"value":233},"Contact information for the developer(s)",{"type":17,"tag":52,"props":235,"children":236},{},[237],{"type":23,"value":238},"Badges",{"type":17,"tag":52,"props":240,"children":241},{},[242],{"type":23,"value":243},"License information",{"type":17,"tag":52,"pr